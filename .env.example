# =============================================================================
# EXAONE Cookbook — environment template (OSS)
#
# (en) Copy to `.env` and fill in values. Never commit `.env` (gitignored).
#      Runtime: `exaone.config` + `eval.run` load root `.env`.
#      Secrets, SSL, logging policy: PLAYBOOK.md Part 8.
#
# (kr) `.env`로 복사 후 값만 채우세요. `.env`는 커밋하지 마세요.
#      런타임: `exaone.config`·`eval.run`이 루트 `.env`를 읽습니다.
#      시크릿·SSL·로그 정책: PLAYBOOK.md Part 8.
#
#   cp .env.example .env
# =============================================================================

# (en) ----- EXAONE API (required for notebooks, recipes, eval) -----
# (kr) ----- EXAONE API (노트북·recipes·eval 필수) -----
# (en) BASE_URL: OpenAI-compatible API base (must end with /v1).
# (kr) BASE_URL: OpenAI 호환 API 베이스(/v1 로 끝나야 함).
# (en) MODEL: leave empty for exaone defaults, or set your deployment model id.
# (kr) MODEL: 비우면 exaone 기본값, 또는 배포 모델 id.
EXAONE_BASE_URL=https://your-openai-compatible-host/v1
EXAONE_API_KEY=
EXAONE_MODEL=your-model-id

# (en) Optional: extra HTTP headers as a JSON object (vendor-specific).
# (kr) 선택: 벤더별 추가 HTTP 헤더(JSON 객체).
# (en) Prefer for new integrations; legacy Friendli may use FRIENDLI_TEAM_ID below.
# (kr) 신규 연동은 이쪽 권장; 레거시 Friendli 는 아래 FRIENDLI_TEAM_ID.
# (en) Example: {"X-Custom-Team-Id": "your-team-id"}
# (kr) 예: {"X-Custom-Team-Id": "your-team-id"}
# EXAONE_API_EXTRA_HEADERS=

# (en) Optional: Friendli Serverless team header (legacy; eval naive_runner).
# (kr) 선택: Friendli Serverless 팀 헤더(레거시; eval naive_runner).
# (en) For custom headers instead, use EXAONE_API_EXTRA_HEADERS.
# (kr) 커스텀 헤더는 EXAONE_API_EXTRA_HEADERS 사용.
# FRIENDLI_TEAM_ID=

# (en) ----- Postgres + pgvector (RAG — infrastructure/setup, Track 04+) -----
# (kr) ----- Postgres + pgvector (RAG — infrastructure/setup, Track 04+) -----
# (en) setup scripts may exit early when POSTGRES_ENABLED / EMBEDDING_ENABLED is 0.
# (kr) POSTGRES_ENABLED / EMBEDDING_ENABLED 가 0 이면 setup 이 조기 종료될 수 있음.
POSTGRES_ENABLED=1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=exaone
POSTGRES_PASSWORD=exaone
POSTGRES_DBNAME=exaone
POSTGRES_SSLMODE=prefer
# (en) Host port conflict (another Postgres already on 5432): set POSTGRES_HOST_PORT
#      (compose host mapping) AND POSTGRES_PORT (app/notebook connect) to the SAME free port (e.g. 5433).
# (kr) 호스트 포트 충돌(다른 Postgres 가 5432 점유) 시: POSTGRES_HOST_PORT(compose 호스트 매핑)와
#      POSTGRES_PORT(앱·노트북 연결)를 같은 빈 포트로(예: 5433) 맞춘다. 컨테이너 내부는 항상 5432.
# POSTGRES_HOST_PORT=5433

# (en) Logical vector table name; unset uses code/setup defaults.
# (kr) 논리 벡터 테이블명; 비우면 코드/setup 기본값.
# PGVECTOR_TABLE_NAME=

EMBEDDING_ENABLED=1
EMBEDDING_BASE_URL=http://localhost:8000
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_API_KEY=
# (en) Optional pgvector dim override; defaults to EMBEDDING_DIMENSIONS in setup(dev).
# (kr) 선택 pgvector 차원; setup(dev) 에서는 EMBEDDING_DIMENSIONS 기본.
# PGVECTOR_EMBEDDING_DIM=384

# (en) Docker setup: see infrastructure/setup/config.py (docker / docker_container).
# (kr) Docker setup: infrastructure/setup/config.py 참고.
# (en) e.g. POSTGRES_HOST=db, EMBEDDING_BASE_URL=http://embedding:80
# (kr) 예: POSTGRES_HOST=db, EMBEDDING_BASE_URL=http://embedding:80

# (en) ----- SSL / TLS (corporate CA, MITM proxies) -----
# (kr) ----- SSL / TLS (회사 CA, MITM 프록시) -----
# (en) Symptom: step1/step3 downloads fail with "CERTIFICATE_VERIFY_FAILED: self-signed certificate in certificate chain".
# (kr) 증상: step1/step3 다운로드가 "CERTIFICATE_VERIFY_FAILED: self-signed certificate in certificate chain" 로 실패.
# (en) Preferred: org root CA bundle (absolute path). How to build the bundle (macOS): infrastructure/setup/README.md.
# (kr) 권장: 조직 루트 CA 번들(절대 경로). 번들 만드는 법(macOS): infrastructure/setup/README.md 참고.
# REQUESTS_CA_BUNDLE=/path/to/company-root.pem
# SSL_CERT_FILE=/path/to/company-root.pem
#
# (en) Disable verification — 1 / true / yes only (weakens security; last resort).
# (kr) 검증 비활성 — 1 / true / yes 만(보안 약화; 최후 수단).
# (en) Do not put inline "# comments" on the same line as values.
# (kr) 값과 같은 줄에 "# 주석" 을 붙이지 마세요.
# DISABLE_SSL_VERIFY=1
# (en) exaone LLM / eval — exaone.config.get_disable_ssl_verify
# (kr) exaone LLM / eval — exaone.config.get_disable_ssl_verify
# HF_HUB_DISABLE_SSL_VERIFICATION=1
# EMBEDDING_DISABLE_SSL_VERIFY=1
# (en) Details: PLAYBOOK.md Part 8
# (kr) 상세: PLAYBOOK.md Part 8

# (en) ----- exaone core tuning (optional — copy uncommented lines into .env) -----
# (kr) ----- exaone core tuning (선택 — 필요한 줄만 .env 에 복사) -----
# CORE_CONTEXT_LENGTH_MAX_TOKENS=256000
# CORE_CONTEXT_LENGTH_RECOMMENDED_TOKENS=128000
# CORE_CHARS_PER_TOKEN_ESTIMATE=4
# CORE_CONTEXT_TOOL_VERBATIM_MAX_TOKENS=4096
# CORE_DEFAULT_MAX_CONTEXT_CHARS=500000
# CORE_LLM_CONNECT_TIMEOUT_S=20
# CORE_LLM_READ_TIMEOUT_S=120
# CORE_MAX_NEW_TOKENS_DEFAULT=4096
# CORE_MAX_NEW_TOKENS_CAP_HINT=8192
# CORE_MAX_IN_FLIGHT_PER_WORKER=8
# CORE_BATCH_CONCURRENCY=4
# CORE_BATCH_MIN_INTERVAL_S=0.05
# CORE_MEMORY_ARTIFACT_MAX_ITEMS=256
# CORE_MEMORY_LEDGER_MAX_ENTRIES=10000
# CORE_MEMORY_TOOL_RESULT_MIN_BYTES=2048

# (en) ----- MCP (Track 03 mcp_demo) -----
# (kr) ----- MCP (Track 03 mcp_demo) -----
# MCP_TOOL_TIMEOUT_S=60

# (en) ----- RAG setup scripts (infrastructure/setup — optional) -----
# (kr) ----- RAG setup scripts (infrastructure/setup — 선택) -----
# HF_TOKEN=
# (en) Cap MS MARCO ingest for local demos; unset or 0 = full corpus (~620k passages).
# (kr) 로컬 데모용 MS MARCO 상한; 비우거나 0 = 전체 코퍼스(~620k).
STEP3_MAX_CONTEXTS=5000
# STEP3_REUSE_VECTORS_IF_NONEMPTY=1
# STEP3_SKIP_VECTOR_INGEST=1
# STEP3_SKIP_GRAPH_BUILD=1

# (en) ----- eval (python -m eval.run) -----
# (kr) ----- eval (python -m eval.run) -----
# (en) Uses EXAONE_* above. For serverless endpoints, increase --sleep to reduce 429s.
# (kr) 위 EXAONE_* 사용. serverless 는 --sleep 을 늘려 429 완화.
# (en) Example: python -m eval.run --limit 25 --pass-k-trials 2 --sleep 3
# (kr) 예: python -m eval.run --limit 25 --pass-k-trials 2 --sleep 3
# (en) Downloaded benchmarks cache under repo root (gitignored).
# (kr) 벤치마크 캐시는 레포 루트(gitignore).
# EVAL_DATASETS_DIR=

# (en) ----- Not environment variables (documentation only) -----
# (kr) ----- 환경 변수 아님 (문서용) -----
# (en) Structured log keys (PLAYBOOK Part 7): request_id, session_id, trace_id, …
# (kr) 구조화 로그 키(PLAYBOOK Part 7): request_id, session_id, trace_id, …
# (en) SLO targets (PLAYBOOK Part 7): availability, error rate, p95/p99 latency, …
# (kr) SLO 목표(PLAYBOOK Part 7): 가용성, 오류율, p95/p99 지연, …
