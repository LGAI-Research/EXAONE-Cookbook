# =============================================================================
# implementations/<repo>/.env — EXAONE credentials for Proof Gallery demos
#
# (en) Copy to `.env` in the same implementation folder (not cookbook root).
#      Run demos with `uv run --project implementations/<repo> ...` or
#      `./implementations/uv_run.sh <repo> python ...`.
# (kr) 같은 implementation 폴더에 `.env`로 복사하세요(cookbook 루트 아님).
#      데모는 `uv run --project implementations/<repo> ...` 또는
#      `./implementations/uv_run.sh <repo> python ...` 로 실행합니다.
#
#   cp .env.example .env
# =============================================================================

# ----- EXAONE API (required) -----
EXAONE_BASE_URL=https://your-openai-compatible-host/v1
EXAONE_API_KEY=
EXAONE_MODEL=your-model-id

# ----- SSL / corporate network (optional) -----
# DISABLE_SSL_VERIFY=0
# REQUESTS_CA_BUNDLE=
