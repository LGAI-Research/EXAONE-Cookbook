# (en) NanoClaw + EXAONE — canonical Path B (add-opencode + custom OpenAI-compatible provider).
# (kr) NanoClaw + EXAONE — 정본 Path B (add-opencode + custom OpenAI-compatible provider).
#
# Copy into YOUR NanoClaw fork .env (not submodules/nanoclaw — read-only pin):
#   cat implementations/nanoclaw/_out/nanoclaw.exaone.env
#
# implementations/nanoclaw/.env (source of truth for EXAONE_*):
# EXAONE_API_KEY=
# EXAONE_BASE_URL=https://your-host/v1
# EXAONE_MODEL=your-model-id
#
# --- OpenCode provider (host .env — synced from EXAONE_*) ---
OPENCODE_PROVIDER=exaone
OPENCODE_MODEL=exaone/your-model-id
OPENCODE_SMALL_MODEL=exaone/your-model-id
# (en) OpenCode non-anthropic providers use this slot for upstream baseURL.
# (kr) OpenCode non-anthropic provider 의 upstream baseURL 슬롯이다.
ANTHROPIC_BASE_URL=https://your-openai-compatible-host/v1
#
# --- Agent provider selection (after apply-opencode + group wiring) ---
# (en) Set provider in groups/<folder>/container.json: "provider": "opencode"
# (kr) groups/<folder>/container.json 에 "provider": "opencode" 설정
#
# --- Credentials (production — do NOT put EXAONE_API_KEY here) ---
# (en) Register EXAONE key in OneCLI; see scripts/print_onecli_exaone.sh
# (kr) EXAONE 키는 OneCLI 에 등록 — scripts/print_onecli_exaone.sh 참고
#
# --- Fallback (not canonical — only if OpenCode path fails) ---
# Path A: Claude-compatible proxy at implementations/nanoclaw/proxy/ (unimplemented)
# ANTHROPIC_BASE_URL=http://127.0.0.1:<proxy-port>
# ANTHROPIC_AUTH_TOKEN=<placeholder-for-onecli>
